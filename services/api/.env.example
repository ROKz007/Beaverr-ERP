NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://beaverr:beaverr@localhost:5432/beaverr
# DIRECT_URL: only needed against a pooled provider (e.g. Supabase's pgbouncer on :6543) — the
# migration engine needs an unpooled connection. Falls back to DATABASE_URL when unset (local
# Docker Postgres). Real Supabase deployment values live in the gitignored .env.production.local,
# never here.
# DIRECT_URL=

REDIS_URL=redis://localhost:6379

JWT_SECRET=change_me_dev_only
JWT_REFRESH_SECRET=change_me_dev_only_refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# console = OTP logged to the API's console instead of sent (MVP default, no cost)
# msg91   = real SMS via MSG91 — requires MSG91_AUTH_KEY + MSG91_TEMPLATE_ID
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# console = notification emails logged to the API's console instead of sent (MVP default, no cost)
# smtp    = real email via nodemailer — requires SMTP_URL (e.g. smtp://user:pass@host:port)
EMAIL_PROVIDER=console
SMTP_URL=
EMAIL_FROM=noreply@beaverr.demo

# Razorpay test-mode keys — get real ones from the Razorpay dashboard (Test Mode) when ready.
# Defaults below let the app boot without them; order-creation calls will fail until set for real.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

FRONTEND_URLS=http://localhost:3000,http://localhost:3001
