// Beaverr — Prisma schema (MVP scope, see docs/Implementation Plan.md Phase 1 step 2)
//
// Scoped to models needed through MVP Phase 4 only. Marketplace and the
// Phase-5-stretch models (events/forum/announcements/documents/emergency) are
// deliberately not modeled yet — add them when those phases start.
//
// Cross-references that aren't the primary society-scoping axis (e.g.
// Unit.ownerUserId, ServiceBooking.workerId) are plain scalar fields without
// an enforced Prisma @relation, matching the loose style in
// docs/Project Description.md's Data Models section. Add a real relation
// once a module actually needs to join through it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RESIDENT
  GUARD
  DEPT_HEAD
  SOCIETY_ADMIN
  SUPER_ADMIN
}

enum UnitType {
  ONE_BHK
  TWO_BHK
  THREE_BHK
  VILLA
}

enum ServiceCategory {
  MAINTENANCE
  AMENITY
  COMMUNITY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
  RATED
}

enum GrievanceType {
  WORKER
  NEIGHBOUR
  MANAGEMENT
  INFRASTRUCTURE
}

enum GrievanceStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum VisitorStatus {
  PENDING
  APPROVED
  DENIED
  INSIDE
  EXITED
}

enum PaymentType {
  MAINTENANCE
  SERVICE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Society {
  id                String   @id @default(cuid())
  name              String
  code              String   @unique
  address           String
  isRestrictedEntry Boolean  @default(false)
  subscriptionPlan  String   @default("free")
  features          Json     @default("{\"FEATURE_VISITOR_MANAGEMENT\":true,\"FEATURE_MARKETPLACE\":false,\"FEATURE_AI_PREDICTIONS\":false,\"FEATURE_PAYMENTS\":true,\"FEATURE_FORUM\":true,\"FEATURE_EMERGENCY_SOS\":true,\"FEATURE_EVENTS\":true,\"FEATURE_DOCUMENTS\":true}")
  adminUserId       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  users         User[]
  units         Unit[]
  departments   Department[]
  services      Service[]
  workers       Worker[]
  bookings      ServiceBooking[]
  grievances    Grievance[]
  visitors      Visitor[]
  payments      Payment[]
  notifications Notification[]
}

model User {
  id           String   @id @default(cuid())
  societyId    String
  name         String
  email        String?
  phone        String
  role         Role
  passwordHash String? // only set for GUARD logins (shared desk device, no personal OTP)
  isActive     Boolean  @default(true)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  society               Society                @relation(fields: [societyId], references: [id])
  notificationPreference NotificationPreference?

  @@unique([societyId, phone])
  @@index([societyId])
}

model Unit {
  id           String   @id @default(cuid())
  societyId    String
  block        String?
  floor        Int?
  unitNumber   String
  type         UnitType
  ownerUserId  String?
  tenantUserId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  society Society @relation(fields: [societyId], references: [id])

  @@unique([societyId, block, unitNumber])
  @@index([societyId])
}

model Department {
  id            String  @id @default(cuid())
  societyId     String
  name          String
  contactName   String?
  phone         String?
  email         String?
  workingHours  String?

  society Society @relation(fields: [societyId], references: [id])

  @@index([societyId])
}

model Service {
  id              String          @id @default(cuid())
  societyId       String
  name            String
  description     String
  category        ServiceCategory
  subCategory     String
  isPaid          Boolean         @default(true)
  price           Float?
  slaHours        Int             @default(24)
  durationEstMins Int             @default(60)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  society  Society          @relation(fields: [societyId], references: [id])
  bookings ServiceBooking[]

  @@index([societyId])
}

model Worker {
  id              String   @id @default(cuid())
  societyId       String
  name            String
  phone           String
  skills          String[]
  ratingAvg       Float    @default(0)
  reputationScore Float    @default(50)
  isVerified      Boolean  @default(false)
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  society  Society          @relation(fields: [societyId], references: [id])
  bookings ServiceBooking[]

  @@index([societyId])
}

model ServiceBooking {
  id            String        @id @default(cuid())
  societyId     String
  serviceId     String
  residentId    String
  workerId      String?
  status        BookingStatus @default(PENDING)
  scheduledAt   DateTime
  completedAt   DateTime?
  rating        Int?
  ratingNote    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  society Society @relation(fields: [societyId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  worker  Worker? @relation(fields: [workerId], references: [id])

  @@index([societyId])
  @@index([residentId])
}

model Grievance {
  id             String          @id @default(cuid())
  societyId      String
  raisedByUserId String
  type           GrievanceType
  againstUserId  String?
  description    String
  mediaUrls      String[]
  status         GrievanceStatus @default(OPEN)
  assignedToId   String?
  isAnonymous    Boolean         @default(false)
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  society Society @relation(fields: [societyId], references: [id])

  @@index([societyId])
  @@index([raisedByUserId])
}

model Visitor {
  id            String        @id @default(cuid())
  societyId     String
  residentId    String
  visitorName   String
  visitorPhone  String?
  photoUrl      String?
  entryAt       DateTime?
  exitAt        DateTime?
  qrToken       String?       @unique
  status        VisitorStatus @default(PENDING)
  isBlacklisted Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  society Society @relation(fields: [societyId], references: [id])

  @@index([societyId])
  @@index([residentId])
}

model Payment {
  id         String        @id @default(cuid())
  societyId  String
  userId     String
  unitId     String
  amount     Float
  type       PaymentType
  gatewayRef String?
  status     PaymentStatus @default(PENDING)
  dueDate    DateTime?
  paidAt     DateTime?
  invoiceUrl String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  society Society @relation(fields: [societyId], references: [id])

  @@index([societyId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  societyId String
  userId    String
  category  String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id])

  @@index([userId])
}

model NotificationPreference {
  id     String  @id @default(cuid())
  userId String  @unique
  email  Boolean @default(true)
  inApp  Boolean @default(true)

  user User @relation(fields: [userId], references: [id])
}
