# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://beaverr:beaverr@localhost:5432/beaverr

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=change_me_dev_only
JWT_REFRESH_SECRET=change_me_dev_only_refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── OTP ──────────────────────────────────────────────
# console = OTP is logged to the API's console instead of sent (MVP default, no cost)
# msg91   = real SMS via MSG91 — requires MSG91_AUTH_KEY + MSG91_TEMPLATE_ID
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ── CORS ─────────────────────────────────────────────
FRONTEND_URLS=http://localhost:3000,http://localhost:3001

# ── Resident/Admin Web (NEXT_PUBLIC_*) ───────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
